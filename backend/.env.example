# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit secrets.

# Anthropic API key for the chat assistant (POST /chat).
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-key-here

# Base URL the chat handler uses to call back into its own API
# (the chat endpoint calls other endpoints over HTTP — "chat is just
# another client of the API"). Default: http://127.0.0.1:8000
# FHH_API_BASE_URL=http://127.0.0.1:8000

# Anthropic model id. Default: claude-sonnet-4-6
# FHH_CHAT_MODEL=claude-sonnet-4-6
