# Frontend environment variables for FHH AI Optimizer
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# In production (Vercel), these are set in the project's Settings → Environment Variables.

# Backend API base URL
# Production (Railway): https://fhh-ai-optimizer-production.up.railway.app
# Local dev: http://127.0.0.1:8000
VITE_API_URL=https://fhh-ai-optimizer-production.up.railway.app
